# Gemini (used in later stages)
GEMINI_API_KEY=

# Gmail account used for IMAP/SMTP
GMAIL_ADDRESS=
# Generate at https://myaccount.google.com/apppasswords (2-Step Verification must be enabled)
GMAIL_APP_PASSWORD=

IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# SMTP (used in later stages)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
